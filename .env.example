# DataForSEO (login = account email)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Ahrefs APIv3 key (free tier: public domain-rating endpoint)
AHREFS_TOKEN=

# OpenRouter
OPENROUTER_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Google OAuth (GSC) - filled by the connect flow, not by hand
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Infra (land with the app skeleton)
DATABASE_URL=postgresql://localhost:5432/pageplans
REDIS_URL=redis://localhost:6379
ARTIFACT_DIR=./artifacts
